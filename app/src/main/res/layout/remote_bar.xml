<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_power" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_power" android:scaleType="center" android:contentDescription="Güç" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_vol_down" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_vol_down" android:scaleType="center" android:contentDescription="Ses azalt" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_mute" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_mute" android:scaleType="center" android:contentDescription="Sessiz" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_vol_up" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_vol_up" android:scaleType="center" android:contentDescription="Ses artır" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_play" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_play" android:scaleType="center" android:contentDescription="Oynat/Duraklat" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageButton android:id="@+id/btn_home" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="center" android:background="@drawable/btn_round"
            android:src="@drawable/ic_home" android:scaleType="center" android:contentDescription="Ana ekran" />
    </FrameLayout>
</LinearLayout>
